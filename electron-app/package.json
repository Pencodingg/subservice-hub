{
  "name": "subservice-hub",
  "productName": "Subservice Hub",
  "version": "1.0.0",
  "description": "Aplikasi desktop Subservice Hub - manajemen data frekuensi",
  "main": "main.cjs",
  "author": "Subservice Hub",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . \"Subservice Hub\" --platform=win32 --arch=x64 --out=release --overwrite --icon=icon.ico",
    "make:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "app.lovable.subservicehub",
    "productName": "Subservice Hub",
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
